# Local-only dotenv file consumed by ./build and scripts/c64_health_check.
# This file is gitignored. It mirrors config/secrets.local but uses KEY=VALUE
# lines so you can also `set -a; source .env.local; set +a` from any shell.
#
# VIVIPI_NETWORK_USERNAME / VIVIPI_NETWORK_PASSWORD are the shared credentials
# for every password-protected network listener on a 1541Ultimate device:
#   - HTTP X-Password header
#   - Telnet login prompt
#   - FTP USER / PASS
#   - DMA TCP/64 SOCKET_CMD_AUTHENTICATE
# They stay in sync because all four listeners check the same CFG_NETWORK_PASSWORD
# on the device side (see 1541ultimate/software/network/socket_dma.cc:99-115,
# socket_gui.cc, ftpd.cc).

VIVIPI_NETWORK_USERNAME=admin
VIVIPI_NETWORK_PASSWORD=replace-with-the-real-device-password