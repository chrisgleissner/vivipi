#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
VENV_DIR="${VENV_DIR:-$ROOT_DIR/.venv}"
CONFIG_PATH="$ROOT_DIR/config/build-deploy.yaml"
OUTPUT_DIR="$ROOT_DIR/artifacts/release"
DIST_DIR="$ROOT_DIR/dist"
RUNTIME_CONFIG_OUTPUT="$ROOT_DIR/artifacts/device/config.json"
HOST="0.0.0.0"
PORT="8080"
DEVICE_PORT=""
DEVICE_ID=""
ALL_DEVICES=0
PROVISION_MISSING=0
COMMAND=""
VERBOSE=0
USE_VENV=1
CONFIG_PATH_EXPLICIT=0
WIFI_SSID="${VIVIPI_WIFI_SSID:-}"
WIFI_PASSWORD="${VIVIPI_WIFI_PASSWORD:-}"
SERVICE_BASE_URL="${VIVIPI_SERVICE_BASE_URL:-}"
NETWORK_USERNAME="${VIVIPI_NETWORK_USERNAME:-}"
NETWORK_PASSWORD="${VIVIPI_NETWORK_PASSWORD:-}"
SECRETS_LOADED=0

has_local_editor_config() {
    if [[ "$CONFIG_PATH" == *.local.yaml ]]; then
        [[ -f "$CONFIG_PATH" ]]
        return
    fi
    if [[ "$CONFIG_PATH" != *.yaml ]]; then
        return 1
    fi

    local local_config_path="${CONFIG_PATH%.yaml}.local.yaml"
    [[ -f "$local_config_path" ]]
}

should_prefer_local_config() {
    [[ "$CONFIG_PATH_EXPLICIT" -eq 0 ]] && [[ "$CONFIG_PATH" != *.local.yaml ]] && has_local_editor_config
}

local_config_will_be_used() {
    [[ "$CONFIG_PATH" == *.local.yaml ]] || should_prefer_local_config
}

usage() {
    cat <<'EOF'
Usage: ./build [command] [options]

Running ./build with no command is equivalent to: ./build ci

Commands that render or package device config require:
    VIVIPI_WIFI_SSID and VIVIPI_WIFI_PASSWORD
Optional for SERVICE checks:
    VIVIPI_SERVICE_BASE_URL
Optional for password-protected C64U/U64 checks (HTTP X-Password, Telnet,
FTP, and DMA TCP/64 SOCKET_CMD_AUTHENTICATE):
    VIVIPI_NETWORK_USERNAME and VIVIPI_NETWORK_PASSWORD
You can provide them as environment variables or with CLI flags.
For local editor workflows, create config/build-deploy.local.yaml to avoid exporting
credentials for ./build render-config, ./build build-firmware, and ./build deploy.
Network credentials can also live in .env.local or config/secrets.local (both
gitignored). See config/secrets.local.example.

Commands:
  ci               Install dependencies, run Ruff, run pytest, and build firmware assets
  install          Create the local virtual environment and install dev dependencies
  lint             Run Ruff
  test             Run pytest
  coverage         Run pytest with branch coverage output
  list-devices     Show configured device selectors and their current state
  render-config    Render artifacts/device/config.json from the build config
  build-firmware   Build the zipped firmware bundle into artifacts/release
  provision        Provision configured BOOTSEL devices with a base UF2
  deploy           Build the firmware bundle and copy it to the configured Pico target(s) via mpremote
  release-assets   Build the versioned GitHub release artifacts
  service          Run the default ADB-backed Vivi Service
  all              Alias for ci
  help             Show this help text

Options:
  -c, --config PATH          Build/deploy config path
  -o, --output-dir PATH      Release output directory
  --runtime-config PATH      Runtime config JSON output path
  --device-port PATH         Optional serial or USB path for single-device mpremote deploy; defaults to auto
  --device ID                Select one named device from a multi-device config
  --all-devices              Select all named devices from a multi-device config; this is the default for fleet-capable commands
  --provision-missing        Provision BOOTSEL devices before deploy when bootstrap metadata is present
  --host HOST                Host for the Vivi Service
  --port PORT                Port for the Vivi Service
  --python PATH              Python executable to use when not in venv
  --venv PATH                Virtualenv directory
  --no-venv                  Use the current Python environment directly
  --wifi-ssid VALUE          Override VIVIPI_WIFI_SSID for this invocation
  --wifi-password VALUE      Override VIVIPI_WIFI_PASSWORD for this invocation
  --service-base-url VALUE   Override VIVIPI_SERVICE_BASE_URL for this invocation
  --network-username VALUE   Override VIVIPI_NETWORK_USERNAME for this invocation
  --network-password VALUE   Override VIVIPI_NETWORK_PASSWORD for this invocation
  -v, --verbose              Print commands before running them
  -h, --help                 Show this help text
EOF
}

log() {
    printf '%s\n' "$*"
}

run_cmd() {
    if [[ "$VERBOSE" -eq 1 ]]; then
        log "+ $*"
    fi
    "$@"
}

ensure_venv() {
    if [[ "$USE_VENV" -eq 0 ]]; then
        return
    fi

    if [[ ! -d "$VENV_DIR" ]]; then
        run_cmd "$PYTHON_BIN" -m venv "$VENV_DIR"
    fi
}

python_cmd() {
    if [[ "$USE_VENV" -eq 1 ]]; then
        printf '%s\n' "$VENV_DIR/bin/python"
        return
    fi
    printf '%s\n' "$PYTHON_BIN"
}

ensure_dependencies() {
    ensure_venv
    local python_path
    python_path="$(python_cmd)"
    run_cmd "$python_path" -m pip install --upgrade pip
    run_cmd "$python_path" -m pip install -e '.[dev]'
}

with_wifi_env() {
    load_local_secrets
    if [[ -n "$WIFI_SSID" ]]; then
        export VIVIPI_WIFI_SSID="$WIFI_SSID"
    fi
    if [[ -n "$WIFI_PASSWORD" ]]; then
        export VIVIPI_WIFI_PASSWORD="$WIFI_PASSWORD"
    fi
    if [[ -n "$SERVICE_BASE_URL" ]]; then
        export VIVIPI_SERVICE_BASE_URL="$SERVICE_BASE_URL"
    fi
    if [[ -n "$NETWORK_USERNAME" ]]; then
        export VIVIPI_NETWORK_USERNAME="$NETWORK_USERNAME"
    fi
    if [[ -n "$NETWORK_PASSWORD" ]]; then
        export VIVIPI_NETWORK_PASSWORD="$NETWORK_PASSWORD"
    fi
}

# Load the locally resolved network credentials into the environment so that
# placeholder resolution for ${VIVIPI_NETWORK_USERNAME} and
# ${VIVIPI_NETWORK_PASSWORD} works without ever committing the actual values.
# Resolution order (highest priority wins): shell exports > .env.local >
# config/secrets.local. Idempotent so callers can invoke it freely.
load_local_secrets() {
    if [[ "$SECRETS_LOADED" -eq 1 ]]; then
        return
    fi
    SECRETS_LOADED=1
    local python_path
    python_path="$(python_cmd || true)"
    if [[ -z "$python_path" || ! -x "$python_path" ]]; then
        return
    fi
    local secrets_json
    local repo_root_for_secrets="${VIVIPI_REPO_ROOT:-$ROOT_DIR}"
    secrets_json="$(
        PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" \
        VIVIPI_REPO_ROOT="$repo_root_for_secrets" \
        "$python_path" - "$repo_root_for_secrets" <<'PYEOF'
import json
import sys
from pathlib import Path

from vivipi.core.secrets import load_network_secrets

root = Path(sys.argv[1]) if len(sys.argv) > 1 else None
print(json.dumps(load_network_secrets(root)))
PYEOF
    )" || secrets_json=""
    local resolved_username resolved_password
    resolved_username="$(printf '%s' "$secrets_json" | "$python_path" -c "import json, sys; print(json.loads(sys.stdin.read() or '{}').get('VIVIPI_NETWORK_USERNAME', ''))" 2>/dev/null || true)"
    resolved_password="$(printf '%s' "$secrets_json" | "$python_path" -c "import json, sys; print(json.loads(sys.stdin.read() or '{}').get('VIVIPI_NETWORK_PASSWORD', ''))" 2>/dev/null || true)"
    if [[ -z "$NETWORK_USERNAME" && -n "$resolved_username" ]]; then
        NETWORK_USERNAME="$resolved_username"
    fi
    if [[ -z "$NETWORK_PASSWORD" && -n "$resolved_password" ]]; then
        NETWORK_PASSWORD="$resolved_password"
    fi
}

run_python_module() {
    local python_path
    python_path="$(python_cmd)"
    run_cmd "$python_path" -m "$@"
}

require_runtime_env() {
    local missing=()

    if local_config_will_be_used; then
        return
    fi

    if [[ -z "$WIFI_SSID" ]]; then
        missing+=("VIVIPI_WIFI_SSID")
    fi
    if [[ -z "$WIFI_PASSWORD" ]]; then
        missing+=("VIVIPI_WIFI_PASSWORD")
    fi

    if [[ ${#missing[@]} -eq 0 ]]; then
        return
    fi

    log "Missing required runtime configuration: ${missing[*]}"
    log "Set them in the environment or pass --wifi-ssid and --wifi-password."
    log "Or create config/build-deploy.local.yaml for local editor-driven workflows."
    log "Example:"
    log "  VIVIPI_WIFI_SSID=wifi VIVIPI_WIFI_PASSWORD=secret ./build $COMMAND"
    log "If you want SERVICE checks, also set VIVIPI_SERVICE_BASE_URL or pass --service-base-url."
    exit 2
}

run_ci_workflow() {
    ensure_dependencies
    run_python_module ruff check .
    run_python_module pytest
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy build-firmware --config "$CONFIG_PATH" --output-dir "$OUTPUT_DIR")
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    run_python_module "${args[@]}"
}

build_firmware_bundle() {
    ensure_dependencies
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy build-firmware --config "$CONFIG_PATH" --output-dir "$OUTPUT_DIR")
    if [[ -n "$DEVICE_ID" ]]; then
        args+=(--device "$DEVICE_ID")
    fi
    if [[ "$ALL_DEVICES" -eq 1 ]]; then
        args+=(--all-devices)
    fi
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    run_python_module "${args[@]}"
}

list_devices() {
    ensure_dependencies
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy list-devices --config "$CONFIG_PATH")
    if [[ -n "$DEVICE_ID" ]]; then
        args+=(--device "$DEVICE_ID")
    fi
    if [[ "$ALL_DEVICES" -eq 1 ]]; then
        args+=(--all-devices)
    fi
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    run_python_module "${args[@]}"
}

render_runtime_config() {
    ensure_dependencies
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy render-config --config "$CONFIG_PATH" --output "$RUNTIME_CONFIG_OUTPUT")
    if [[ -n "$DEVICE_ID" ]]; then
        args+=(--device "$DEVICE_ID")
    fi
    if [[ "$ALL_DEVICES" -eq 1 ]]; then
        args+=(--all-devices)
    fi
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    run_python_module "${args[@]}"
}

build_python_wheel() {
    ensure_dependencies
    local python_path
    python_path="$(python_cmd)"
    mkdir -p "$DIST_DIR"
    find "$DIST_DIR" -maxdepth 1 -type f \( -name 'vivipi-*.whl' -o -name 'vivipi-*.tar.gz' \) -delete
    run_cmd "$python_path" -m build --wheel --outdir "$DIST_DIR"
}

stage_release_assets() {
    ensure_dependencies
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy stage-release-assets --config "$CONFIG_PATH" --output-dir "$OUTPUT_DIR" --dist-dir "$DIST_DIR")
    if [[ -n "$DEVICE_ID" ]]; then
        args+=(--device "$DEVICE_ID")
    fi
    if [[ "$ALL_DEVICES" -eq 1 ]]; then
        args+=(--all-devices)
    fi
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    run_python_module "${args[@]}"
}

deploy_bundle() {
    ensure_dependencies
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy deploy-firmware --config "$CONFIG_PATH" --output-dir "$OUTPUT_DIR")
    if [[ -n "$DEVICE_ID" ]]; then
        args+=(--device "$DEVICE_ID")
    fi
    if [[ "$ALL_DEVICES" -eq 1 ]]; then
        args+=(--all-devices)
    fi
    if [[ "$PROVISION_MISSING" -eq 1 ]]; then
        args+=(--provision-missing)
    fi
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    if [[ -n "$DEVICE_PORT" ]]; then
        if [[ -n "$DEVICE_ID" || "$ALL_DEVICES" -eq 1 ]]; then
            log "--device-port is only supported for single-device deploy"
            exit 2
        fi
        args+=(--port "$DEVICE_PORT")
    fi
    run_python_module "${args[@]}"
}

provision_bundle() {
    ensure_dependencies
    require_runtime_env
    with_wifi_env
    local args=(vivipi.tooling.build_deploy provision-firmware --config "$CONFIG_PATH" --output-dir "$OUTPUT_DIR")
    if [[ -n "$DEVICE_ID" ]]; then
        args+=(--device "$DEVICE_ID")
    fi
    if [[ "$ALL_DEVICES" -eq 1 ]]; then
        args+=(--all-devices)
    fi
    if should_prefer_local_config; then
        args+=(--prefer-local-config)
    fi
    run_python_module "${args[@]}"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            install|lint|test|coverage|ci|list-devices|render-config|build-firmware|provision|release-assets|deploy|service|all|help)
                COMMAND="$1"
                shift
                ;;
            -c|--config)
                CONFIG_PATH="$2"
                CONFIG_PATH_EXPLICIT=1
                shift 2
                ;;
            -o|--output-dir)
                OUTPUT_DIR="$2"
                shift 2
                ;;
            --runtime-config)
                RUNTIME_CONFIG_OUTPUT="$2"
                shift 2
                ;;
            --host)
                HOST="$2"
                shift 2
                ;;
            --port)
                PORT="$2"
                shift 2
                ;;
            --device-port)
                DEVICE_PORT="$2"
                shift 2
                ;;
            --device)
                DEVICE_ID="$2"
                shift 2
                ;;
            --all-devices)
                ALL_DEVICES=1
                shift
                ;;
            --provision-missing)
                PROVISION_MISSING=1
                shift
                ;;
            --python)
                PYTHON_BIN="$2"
                shift 2
                ;;
            --venv)
                VENV_DIR="$2"
                shift 2
                ;;
            --no-venv)
                USE_VENV=0
                shift
                ;;
            --wifi-ssid)
                WIFI_SSID="$2"
                shift 2
                ;;
            --wifi-password)
                WIFI_PASSWORD="$2"
                shift 2
                ;;
            --service-base-url)
                SERVICE_BASE_URL="$2"
                shift 2
                ;;
            --network-username)
                NETWORK_USERNAME="$2"
                shift 2
                ;;
            --network-password)
                NETWORK_PASSWORD="$2"
                shift 2
                ;;
            -v|--verbose)
                VERBOSE=1
                shift
                ;;
            -h|--help)
                COMMAND="help"
                shift
                ;;
            *)
                log "Unknown argument: $1"
                usage
                exit 2
                ;;
        esac
    done

    if [[ -z "$COMMAND" ]]; then
        COMMAND="ci"
    fi
}

main() {
    cd "$ROOT_DIR"
    parse_args "$@"

    case "$COMMAND" in
        install)
            ensure_dependencies
            ;;
        lint)
            ensure_dependencies
            run_python_module ruff check .
            ;;
        test)
            ensure_dependencies
            run_python_module pytest
            ;;
        coverage)
            ensure_dependencies
            run_python_module pytest --cov=src/vivipi --cov-branch --cov-report=term-missing --cov-report=xml
            ;;
        list-devices)
            list_devices
            ;;
        ci)
            run_ci_workflow
            ;;
        render-config)
            render_runtime_config
            ;;
        build-firmware)
            build_firmware_bundle
            ;;
        provision)
            provision_bundle
            ;;
        release-assets)
            build_python_wheel
            stage_release_assets
            ;;
        deploy)
            deploy_bundle
            ;;
        service)
            ensure_dependencies
            run_python_module vivipi.services.adb_service --host "$HOST" --port "$PORT"
            ;;
        all)
            run_ci_workflow
            ;;
        help)
            usage
            ;;
        *)
            log "Unsupported command: $COMMAND"
            exit 2
            ;;
    esac
}

main "$@"
